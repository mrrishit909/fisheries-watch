 "components": {
  "schemas": {
   "CaseIn": {
    "properties": {
     "vessel_id": {
      "type": "string",
      "format": "uuid",
      "title": "Vessel Id"
     },
     "summary": {
      "type": "string",
      "maxLength": 2000,
      "minLength": 10,
      "title": "Summary"
     }
    },
    "type": "object",
    "required": [
     "vessel_id",
     "summary"
    ],
    "title": "CaseIn"
   },
   "EscalateIn": {
    "properties": {
     "action": {
      "type": "string",
      "pattern": "^(request_inspection|notify_flag_state|refer_to_port_state)$",
      "title": "Action"
     },
     "note": {
      "type": "string",
      "maxLength": 1000,
      "minLength": 3,
      "title": "Note"
     }
    },
    "type": "object",
    "required": [
     "action",
     "note"
    ],
    "title": "EscalateIn"
   },
   "Fix": {
    "properties": {
     "mmsi": {
      "type": "integer",
      "title": "Mmsi"
     },
     "ts": {
      "type": "string",
      "format": "date-time",
      "title": "Ts"
     },
     "x_km": {
      "type": "number",
      "title": "X Km"
     },
     "y_km": {
      "type": "number",
      "title": "Y Km"
     },
     "sog_kn": {
      "type": "number",
      "maximum": 60.0,
      "minimum": 0.0,
      "title": "Sog Kn"
     }
    },
    "type": "object",
    "required": [
     "mmsi",
     "ts",
     "x_km",
     "y_km",
     "sog_kn"
    ],
    "title": "Fix"
   },
   "HTTPValidationError": {
    "properties": {
     "detail": {
      "items": {
       "$ref": "#/components/schemas/ValidationError"
      },
      "type": "array",
      "title": "Detail"
     }
    },
    "type": "object",
    "title": "HTTPValidationError"
   },
   "IngestIn": {
    "properties": {
     "fixes": {
      "items": {
       "$ref": "#/components/schemas/Fix"
      },
      "type": "array",
      "maxItems": 5000,
      "minItems": 1,
      "title": "Fixes"
     }
    },
    "type": "object",
    "required": [
     "fixes"
    ],
    "title": "IngestIn"
   },
   "LoadIn": {
    "properties": {
     "seed": {
      "type": "integer",
      "maximum": 1000000.0,
      "minimum": 0.0,
      "title": "Seed",
      "default": 15
     }
    },
    "type": "object",
    "title": "LoadIn"
   },
   "PollIn": {
    "properties": {
     "hours": {
      "type": "integer",
      "maximum": 48.0,
      "minimum": 1.0,
      "title": "Hours",
      "default": 48
     }
    },
    "type": "object",
    "title": "PollIn"
   },
   "ScoreIn": {
    "properties": {
     "top": {
      "type": "integer",
      "maximum": 110.0,
      "minimum": 1.0,
      "title": "Top",
      "default": 10
     }
    },
    "type": "object",
    "title": "ScoreIn"
   },
   "ValidationError": {
    "properties": {
     "loc": {
      "items": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "integer"
        }
       ]
      },
      "type": "array",
      "title": "Location"
     },
     "msg": {
      "type": "string",
      "title": "Message"
     },
     "type": {
      "type": "string",
      "title": "Error Type"
     },
     "input": {
      "title": "Input"
     },
     "ctx": {
      "type": "object",
      "title": "Context"
     }
    },
    "type": "object",
    "required": [
     "loc",
     "msg",
     "type"
    ],
    "title": "ValidationError"
   }
  }
 }
}