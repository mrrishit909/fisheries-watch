  "/v1/cases/{case_id}/escalate": {
   "post": {
    "tags": [
     "cases"
    ],
    "summary": "(+) Escalate a case to an action outside the centre (an at-sea inspection, the flag state, the port state); needs a supervisor who did not open it",
    "operationId": "escalate_v1_cases__case_id__escalate_post",
    "parameters": [
     {
      "name": "case_id",
