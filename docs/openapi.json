  "/v1/risk/score": {
   "post": {
    "tags": [
     "risk"
    ],
    "summary": "Score every fishing vessel over the fortnight: a logistic model over its worst silence, dark sightings near the reserve, undeclared carrier encounters, being a loitering carrier's likely dark partner, and the registry; each factor's contribution is returned, with a ranking by silent hours beside it",
    "operationId": "score_v1_risk_score_post",
    "parameters": [
     {
      "name": "Idempotency-Key",
